# Store and check out LF on every OS (including Windows). This is a portable
# tools repo used across Windows and Linux; forcing LF everywhere keeps the
# working tree identical to the index and prevents CRLF churn from a raw
# cross-OS folder copy.
* text=auto eol=lf

# Binary types: never apply text/EOL filtering to these.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.zip    binary
*.gz     binary
*.skill  binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
*.pdf    binary
